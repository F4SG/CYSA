  "components": {
    "schemas": {
      "Activo": {
        "properties": {
          "activo_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Activo Id"
          },
          "interseccion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Interseccion"
          },
          "acceso": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acceso"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "interseccion",
              "acceso",
              "camara",
              "controlador"
            ],
            "title": "Tipo"
          },
          "ubicacion": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Ubicacion"
          },
          "protocolo": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Protocolo"
          },
          "prueba": {
            "type": "boolean",
            "title": "Prueba"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activo_id",
          "interseccion",
          "tipo",
          "ubicacion",
          "protocolo",
          "prueba"
        ],
        "title": "Activo"
      },
      "Carga": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Activo"
            },
            "type": "array",
            "maxItems": 2000,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Carga"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
